{
  "name": "associae",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "cross-env TEST_REQUIRE_DATABASE=1 vitest run --project integration",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:e2e": "playwright test",
    "test:e2e:dev": "cross-env E2E_DEV=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:all-browsers": "cross-env E2E_ALL_BROWSERS=1 playwright test",
    "test:all": "pnpm test && pnpm test:browser && pnpm test:e2e",
    "db:migrate": "drizzle-kit migrate",
    "platform-admin:grant": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/grant-platform-admin.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-form": "^1.33.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "1.0.0-rc.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.56.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^64.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
