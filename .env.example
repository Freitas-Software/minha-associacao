# PostgreSQL connection used by the application
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minha_associacao

# PostgreSQL connection used by database integration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minha_associacao

# Resend credentials used to deliver confirmation and password reset emails
RESEND_API_KEY=
EMAIL_FROM=

# Public base URL of the application (HTTPS outside local development)
APP_URL=http://localhost:3000

# Required outside Vercel when a trusted reverse proxy sets the client IP header
LOGIN_TRUSTED_IP_HEADER=
