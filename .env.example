# PostgreSQL connection used by the application
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/associae

# Dedicated PostgreSQL database used by Vitest integration tests and Playwright.
# Its schema is recreated on every run, so the database name must contain "test".
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/associae_test

# Optional dedicated database for Playwright. Defaults to TEST_DATABASE_URL.
E2E_DATABASE_URL=

# Resend credentials used to deliver confirmation and password reset emails
RESEND_API_KEY=
EMAIL_FROM=

# Public base URL of the application (HTTPS outside local development)
APP_URL=http://localhost:3000

# Required outside Vercel when a trusted reverse proxy sets the client IP header
LOGIN_TRUSTED_IP_HEADER=

# Bearer token required by the scheduled cleanup route
CRON_SECRET=

# Vercel Blob read-write token used for organization documents
BLOB_READ_WRITE_TOKEN=
